{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/gen-map.mjs\" >/dev/null 2>&1 || true",
            "async": true,
            "statusMessage": "Refreshing docs/MAP.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-context.mjs\" --quiet 2>/dev/null || true",
            "statusMessage": "Checking shared context"
          }
        ]
      }
    ]
  }
}
